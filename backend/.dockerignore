# Docker build-context exclusions (mirrors the spirit of .gitignore, scoped
# to what the Cloud Build image itself needs at runtime — see
# backend/Dockerfile / docs/DEPLOYMENT.md's Cloud Run section).

# Never ship a local secret into the image (Cloud Run env vars are set in
# its own console instead — docs/ENVIRONMENT.md).
.env
.env.local
.env.*.local

# Local virtualenv — huge (~1GB+) and irrelevant; the image installs its own
# dependencies from requirements.txt via pip instead.
.venv/
venv/

# Python bytecode/cache — regenerated at runtime, never needed in the image.
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# Tests — not needed to serve the app; keeps the image smaller and avoids
# shipping test fixtures.
tests/

# VCS/editor/OS metadata — irrelevant to the running container.
.git/
.gitignore
.vscode/
.idea/
.DS_Store
*.log
