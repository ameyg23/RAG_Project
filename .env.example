# Backend environment variables — see docs/ENVIRONMENT.md for full details.
# Copy to backend/.env for local development. Never commit a real .env file.
# Frontend env vars live in frontend/.env.example (created in the implementation phase).

# Secret: Groq LLM API key (https://console.groq.com)
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY

# Sensitive: Qdrant Cloud cluster endpoint
QDRANT_URL=https://REPLACE.cloud.qdrant.io:6333

# Secret: Qdrant Cloud API key
QDRANT_API_KEY=REPLACE_WITH_YOUR_QDRANT_KEY

# The single frontend origin allowed to call this API
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Optional: local embedding model name, loaded via fastembed/ONNX Runtime
# (ADR-20; no PyTorch dependency) (default shown)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Optional: Groq-hosted model name (default shown, ADR-08). Groq's free-tier
# catalog changes over time - re-verify with client.models.list() before
# assuming this default is still valid.
LLM_MODEL_NAME=qwen/qwen3.8-27b

# Local dev port (Render provides this automatically in production)
PORT=8000
